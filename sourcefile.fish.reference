# Auto-generated by `bashrs generate` — do not edit.
# Regenerate by re-running COMPILE.sh.
# fish counterpart of sourcefile.sh — load it from ~/.config/fish/config.fish with:
#   test -r "$HOME/.bashrs/sourcefile.fish"; and source "$HOME/.bashrs/sourcefile.fish"

status is-interactive; or return 0  # interactive shells only — non-interactive contexts must inherit nothing
if set -q _BASHRS_BARE; set -e _BASHRS_BARE; return 0; end  # shell_bare: skip bashrs for THIS shell, flag consumed (any new shell arms again)
test -f "$HOME/.bashrs/bashrs"; or return 0

# bashrs
function brs_compile    -d 'Recompile and reinstall bashrs by running the project\'s COMPILE.sh'; "$HOME/.bashrs/bashrs" brs_compile $argv; set -l __rc $status; test $__rc -eq 97; and shell_new; return $__rc; end
function brs_test       -d 'Run the project\'s full test suite by running its TEST.sh — every category, the live and cookie-gated ones included (those self-skip where the machine\'s setup lacks the pieces)'; "$HOME/.bashrs/bashrs" brs_test $argv; end
function brs_configure  -d 'Tick the bashrs settings on or off in a form (~/.bashrs/configrs.toml), creating it on first use; `-e` opens the file in your editor instead'; "$HOME/.bashrs/bashrs" brs_configure $argv; end
function brs_map_comfy  -d 'Draw how my own crates depend on each other, and which of them are shared'; "$HOME/.bashrs/bashrs" brs_map_comfy $argv; end
function brs_sourcefile -d 'Print the autogenerated source file, noting where it lives'; "$HOME/.bashrs/bashrs" brs_sourcefile $argv; end
function brs_cd         -d '`cd` to the bashrs project\'s root directory (where it stood at the last compile)'; cd -- '/run/media/phillip/ALT_X/my_repositories/main/comfy_linux/bashrs'; end
function dotbashrs_cd   -d '`cd` to ~/.bashrs — the installation: binary, sourcefile, config, tools, user-data'; cd -- "$HOME/.bashrs"; end

# overrides
function diff -d '`git diff` between any two files or directories — no repository needed — with what changed inside each changed line highlighted'; "$HOME/.bashrs/bashrs" diff $argv; end
functions -q __bashrs_orig_cd; or functions -c cd __bashrs_orig_cd  # keep fish's own `cd` (dir history, `cd -`) once, so re-sourcing doesn't wrap the wrapper
function cd   -d '`cd`, then print what you landed in: `ls -AF`, directories first, colours on'; __bashrs_orig_cd $argv; and ls -AF --color=always --group-directories-first --quoting-style=shell-escape; end

# filesystem
function lll      -d 'Custom `ls` (like `ll`): a long, all-files listing aligned into a table. Extra arguments pass straight through to `ls` — e.g. `lll -S` sorts by size'; "$HOME/.bashrs/bashrs" lll $argv; end
function LLL      -d '`lll` and `fs_usage` in one table: what each entry costs on disk — recursive size, file count, inode count — joined onto its listing row, largest first'; "$HOME/.bashrs/bashrs" LLL $argv; end
function fs_usage -d 'Disk usage overview: each entry\'s allocated size, recursive file count, and inode count, largest first with a total — like `du`, hardlinked twins counted once'; "$HOME/.bashrs/bashrs" fs_usage $argv; end
function ..       -d 'Hop one directory up'; cd .. $argv; end

# git
function git_tree     -d 'A pretty, one-line commit graph across all branches'; "$HOME/.bashrs/bashrs" git_tree $argv; end
function git_rec_pull -d 'Recursively run `git pull` in every directory below here that holds a `.git`'; "$HOME/.bashrs/bashrs" git_rec_pull $argv; end
function git_profile  -d 'Show the git identity in effect here: last commit\'s author, the configured `user.email` (and where it\'s set), who GitHub authenticates you as, and the remotes'; "$HOME/.bashrs/bashrs" git_profile $argv; end

# download
function dl_page_links -d 'Download every link of the given file types found in a webpage, into the current dir'; "$HOME/.bashrs/bashrs" dl_page_links $argv; end

# exposed_helpers
function _arg_lean_spec -d 'Print exactly what `--lean` skips (gg, GG, detect_ai_textual_fingerprint): every pattern, grouped by ecosystem, with what fills each directory'; "$HOME/.bashrs/bashrs" _arg_lean_spec $argv; end

# media
function media_convert         -d 'Convert a media file to another format'; "$HOME/.bashrs/bashrs" media_convert $argv; end
function media_convert_quality -d 'Convert a media file to another format at maximum fidelity — copying the streams losslessly when the target container already fits them, else encoding at visually-lossless settings (H.265 video) with generous audio'; "$HOME/.bashrs/bashrs" media_convert_quality $argv; end
function media_convert_compact -d 'Convert a media file to another format squeezing the visuals down hard (H.265 video); audio (if any) stays on its encoder defaults'; "$HOME/.bashrs/bashrs" media_convert_compact $argv; end
function media_trim            -d 'Keep one stretch of a video/audio file: from a start, up to an end, or between the two — frame-accurate (re-encoding on the output container\'s defaults), or instant and lossless with `--copy` at keyframe precision'; "$HOME/.bashrs/bashrs" media_trim $argv; end
function media_metadata        -d 'Get metadata of an audio/video/image file: container and per-stream facts, plus any embedded tags (a yt-dlp download carries title, uploader, date, description, and source URL) — one style throughout: a blue title leading its value on the same line, or an indented block from the next line for multi-line values. A file with no tags just shows no tags'; "$HOME/.bashrs/bashrs" media_metadata $argv; end
function media_remove_vocals   -d 'Copy an audio or video file with the vocals removed — center-channel cancellation over a tunable frequency band; video, subtitles, and cover art pass through untouched'; "$HOME/.bashrs/bashrs" media_remove_vocals $argv; end
function media_hmerge_imgs     -d 'Merge images side by side onto one canvas — as tall as the tallest input, as wide as all inputs combined; nothing is scaled, and `--align` places each image vertically'; "$HOME/.bashrs/bashrs" media_hmerge_imgs $argv; end
function media_vmerge_imgs     -d 'Merge images top to bottom onto one canvas — as wide as the widest input, as tall as all inputs combined; nothing is scaled, and `--align` places each image horizontally'; "$HOME/.bashrs/bashrs" media_vmerge_imgs $argv; end

# network
function net_excavate  -d 'Dig up everything about a host or address: DNS records, who owns the addresses, the certificate, and where HTTP leads — in one pass'; "$HOME/.bashrs/bashrs" net_excavate $argv; end
function net_sonar     -d 'Time the handshake to the internet\'s busiest hosts — several endpoints per provider, probed in parallel — so "is it me, or is it them?" is answered in one screen'; "$HOME/.bashrs/bashrs" net_sonar $argv; end
function net_health    -d 'Time the handshake to the internet\'s busiest hosts — several endpoints per provider, probed in parallel — so "is it me, or is it them?" is answered in one screen'; "$HOME/.bashrs/bashrs" net_sonar $argv; end
function net_local     -d 'List the devices around this machine — IP and Bluetooth both. Finds even IP devices that ignore every probe, by reading the kernel\'s ARP table after provoking it; no root, no raw sockets. Bluetooth is discovered too, so a device advertising to pair shows up (`--no-bluetooth` skips that wait)'; "$HOME/.bashrs/bashrs" net_local $argv; end
function net_vendor    -d 'Name the manufacturer behind a MAC address — for putting a name to the mouse, keyboard or nameless box that turned up in a scan. Takes any spelling, and only needs the first three octets'; "$HOME/.bashrs/bashrs" net_vendor $argv; end
function net_bluetooth -d 'List the Bluetooth devices this machine knows: what is paired, what is connected, and — with `--scan` — whatever is advertising nearby right now. Says which part of the stack is missing when nothing shows up'; "$HOME/.bashrs/bashrs" net_bluetooth $argv; end

# packages
function packages_upup              -d 'Update and upgrade every package manager present on the system'; "$HOME/.bashrs/bashrs" packages_upup $argv; end
function upup                       -d 'Update and upgrade every package manager present on the system'; "$HOME/.bashrs/bashrs" packages_upup $argv; end
function packages_update_toolchains -d 'Update the development toolchains (rustup, uv, ...) that are installed'; "$HOME/.bashrs/bashrs" packages_update_toolchains $argv; end
function UPUP                       -d 'Update everything: package managers, then dev toolchains, then bashrs\'s own bundled tools and companion repos (the same provisioning COMPILE.sh runs)'; "$HOME/.bashrs/bashrs" UPUP $argv; end
function packages_print             -d 'List installed packages, grouped under their package manager'; "$HOME/.bashrs/bashrs" packages_print $argv; end

# processes
function murder -d 'Find running processes by any part of them — PID, program name, full command line, or the executable\'s path — show each match in its process-tree (ancestors above say who owns it, descendants beneath say what else goes down with it, matched text glowing `grep`-style), then offer to terminate the matches: SIGTERM first, SIGKILL only for whatever ignores it. With nothing to hunt at all, offers the top CPU and memory consumers as a checklist'; "$HOME/.bashrs/bashrs" murder $argv; end

# project
function pro_compile         -d 'Build the project in DIR (default `.`); `-d` debug (fastest compile), `-r` release (fastest runtime, the default), `-t` tiny (smallest binary)'; "$HOME/.bashrs/bashrs" pro_compile $argv; end
function pro_test            -d 'Run the test suite of the project in DIR (default `.`)'; "$HOME/.bashrs/bashrs" pro_test $argv; end
function pro_run             -d 'Build and run a project (default: the current directory\'s), handing every argument on to the program'; "$HOME/.bashrs/bashrs" pro_run $argv; end
function pro_update_packages -d 'Upgrade the dependencies of the project in DIR (default `.`)'; "$HOME/.bashrs/bashrs" pro_update_packages $argv; end
function pro_readme          -d 'Show the project\'s README, else its manifest description, else its main file\'s doc'; "$HOME/.bashrs/bashrs" pro_readme $argv; end
function pro_todo            -d 'Print the project\'s TODOs, both kinds: every TODO file in DIR\'s root (the name in any letter case, with any extension or none) in full — then every `todo` mention in the tree, found with the `gg` engine and always `--lean` (machine-written dirs skipped; `_arg_lean_spec` lists them), so vendored and build-output TODOs stay out. A mention counts only with no ASCII letter touching it (`TODO:`, `# todo`, `todo!(…)` — not `todos`, `MyTODO`); `--match-any-todo` drops that and takes the substring anywhere'; "$HOME/.bashrs/bashrs" pro_todo $argv; end

# python
function py_install  -d 'Install python package(s) into bashrs\'s bundled environment, at their latest (upgrading if already present) — uv-managed'; "$HOME/.bashrs/bashrs" py_install $argv; end
function py_update   -d 'Upgrade every python package in the bundled environment (python itself updates on compile)'; "$HOME/.bashrs/bashrs" py_update $argv; end
function py_rollback -d 'Revert the bundled environment\'s packages to their pre-last-change versions — the escape hatch when a latest-version install/update breaks something'; "$HOME/.bashrs/bashrs" py_rollback $argv; end

# shell
function shell_args_print -d 'The words a shell hands a program are not the words you typed: by the time argv exists the shell has already expanded variables and globs, split on whitespace, and stripped the quotes that told it where the boundaries were. `shell_args_print` is a program that does nothing but report that argv back — so `shell_args_print "$x"` and `shell_args_print $x` are a before/after of word-splitting you can see. A classic teaching tool; demonstrated well at https://www.youtube.com/watch?v=w-PgWIZm5Qs'; "$HOME/.bashrs/bashrs" shell_args_print $argv; end
function shell_def        -d '\'define\' the given name(s): what runs first, then everything it outranks, each labeled'; for __n in $argv; printf '%s\0%s\0%s\0%s\0' '' (functions -- $__n | string collect) (set --show -- $__n | string collect) (type -a -t -- $__n | string collect); end 2>/dev/null | "$HOME/.bashrs/bashrs" shell_def $argv; end  # fields: alias (fish has none — `alias` makes functions), function, variable, type
function sudo_bashrs      -d 'Move into a root shell with bashrs sourced — for running several elevated commands without a password each time. `exit` returns here. Files written inside are root-owned'; "$HOME/.bashrs/bashrs" sudo_bashrs $argv; end
function shell_new        -d 'Start a fresh shell session'; exec fish; end
function shell_bare       -d 'Fresh shell WITHOUT bashrs (one-shot: any later shell, or re-sourcing, arms it again)'; set -gx _BASHRS_BARE 1; exec fish; end

# lookup
function g    -d 'Case-insensitive grep-search (literal, or regex with -E), colouring matches'; "$HOME/.bashrs/bashrs" g $argv; end
function g2   -d 'Case-insensitive grep-search, showing 2 lines of context around each match'; "$HOME/.bashrs/bashrs" g2 $argv; end
function g3   -d 'Case-insensitive grep-search, showing 3 lines of context around each match'; "$HOME/.bashrs/bashrs" g3 $argv; end
function g5   -d 'Case-insensitive grep-search, showing 5 lines of context around each match'; "$HOME/.bashrs/bashrs" g5 $argv; end
function g8   -d 'Case-insensitive grep-search, showing 8 lines of context around each match'; "$HOME/.bashrs/bashrs" g8 $argv; end
function g25  -d 'Case-insensitive grep-search, showing 25 lines of context around each match'; "$HOME/.bashrs/bashrs" g25 $argv; end
function gg   -d 'Roughly `find`+`grep`: Recursively search a directory for expression(s) — filenames, then file contents'; "$HOME/.bashrs/bashrs" gg $argv; end
function gg2  -d 'Recursive search, showing 2 lines of context around each file-content match'; "$HOME/.bashrs/bashrs" gg2 $argv; end
function gg3  -d 'Recursive search, showing 3 lines of context around each file-content match'; "$HOME/.bashrs/bashrs" gg3 $argv; end
function gg5  -d 'Recursive search, showing 5 lines of context around each file-content match'; "$HOME/.bashrs/bashrs" gg5 $argv; end
function gg10 -d 'Recursive search, showing 10 lines of context around each file-content match'; "$HOME/.bashrs/bashrs" gg10 $argv; end
function GG   -d 'Recursive search with `--delve` and `--lean` always on — looks inside binaries we can decode (video subtitle tracks, `.torrent` text), and skips the machine-written directories (`_arg_lean_spec` lists them). Please: no `--re`'; "$HOME/.bashrs/bashrs" GG $argv; end
function GGG  -d '`GG` plus the two extras: `--save` (`-s`, leave sorted results in `deep_search_<time>_sorted`) and regex (`-E`). The everything-on, all-caps deep search — `--lean`\'s skips apply here too (`_arg_lean_spec` lists them)'; "$HOME/.bashrs/bashrs" GGG $argv; end
function hg    -d 'Search your shell history (case-insensitive, literal) — like `history | grep -iF`'; history | "$HOME/.bashrs/bashrs" hg $argv; end

