# comfy_repos
function table                         -d 'Align whitespace-delimited columns into a neat table — or paste an HTML <table> (a saved wiki/docs page) and it\'s translated into one (table_formatter)'; "$HOME/.bashrs/bashrs" table $argv; end
function table_fancy                   -d '`table` in its framed, terminal-width form: `-j " | " --split-lines --space-rows \'-\' --emit-frame` — pipe-joined columns in a border, records ruled apart, wide rows wrapped to fit the window (table_formatter)'; "$HOME/.bashrs/bashrs" table_fancy $argv; end
function backup_diff                   -d 'Report what a backup sync would do (new / changed / moved / deleted); changes nothing (filesync diff)'; "$HOME/.bashrs/bashrs" backup_diff $argv; end
function backup_sync                   -d 'Make DEST mirror SOURCE: copy new/changed, rename moves, delete extras; resumable (filesync sync)'; "$HOME/.bashrs/bashrs" backup_sync $argv; end
function backup_find_bitrot            -d 'Verify a mirror by content: `backup_diff` comparing every file\'s bytes (blake3), so silent corruption can\'t hide behind a matching size+mtime (filesync diff --eager-checksum)'; "$HOME/.bashrs/bashrs" backup_find_bitrot $argv; end
function clicker                       -d 'Hold or toggle a key (default F9) to click — or to repeat a keyboard key — at a chosen rate, wherever the mouse already is; F8 quits. Works on X11, Wayland and the console alike; on X11 it needs no privileges at all. If device access is needed and missing, the error walks you through the fix (sequencer clicker)'; "$HOME/.bashrs/bashrs" clicker $argv; end
function autoclick                     -d 'Hold or toggle a key (default F9) to click — or to repeat a keyboard key — at a chosen rate, wherever the mouse already is; F8 quits. Works on X11, Wayland and the console alike; on X11 it needs no privileges at all. If device access is needed and missing, the error walks you through the fix (sequencer clicker)'; "$HOME/.bashrs/bashrs" clicker $argv; end
function clicker_benchmark             -d 'Measure what this machine can really deliver: writes key presses as fast as asked (or flat out, with no `--cps`) while reading its own virtual device back, printing the live rate as it goes. The gap between written and delivered is the honest ceiling — a rate counted from the sending loop alone would never show it (sequencer bench)'; "$HOME/.bashrs/bashrs" clicker_benchmark $argv; end
function autokey_doctor                -d 'Check everything the synthetic-input commands need — the uinput module loaded, /dev/uinput writable, /dev/input readable — and print the exact commands to fix whatever is missing. One check for the whole family: `clicker` and the `autokey_*` profile commands open the same devices. Exit 0 means ready (sequencer doctor)'; "$HOME/.bashrs/bashrs" autokey_doctor $argv; end
function autokey_check                 -d 'Check binds files for problems without applying them: nothing is activated, no profile state is touched, and the files are left exactly as they are. `autokey_reformat` is the same check with tidying turned on (sequencer profile-check)'; "$HOME/.bashrs/bashrs" autokey_check $argv; end
function autokey_reformat              -d '`autokey_check` that also rewrites: every file that parses is tidied in place with all its comments kept, and one that doesn\'t is reported and left alone. Still activates nothing — the rewrite is the only thing it changes (sequencer profile-check --format)'; "$HOME/.bashrs/bashrs" autokey_reformat $argv; end
function autokey_apply                 -d 'Apply binds profiles: remap keys and run sequences until stopped. Each FILE is linked into the active set (naming a directory takes every `.toml` directly inside it, in name order); naming nothing applies the profile store, ~/.bashrs/user-data/sequencer. The first invocation becomes the manager and later ones add to it (sequencer profile-apply)'; "$HOME/.bashrs/bashrs" autokey_apply $argv; end
function autokey_list_bashrs_profiles  -d 'List the profile store (~/.bashrs/user-data/sequencer): every binds profile in it, RECURSIVELY, and every directory — `autokey_apply` expands a directory non-recursively on purpose, so each directory is its own applyable unit and earns its own line (a trailing `/`). Full paths, made to be copied straight onto an `autokey_apply` line: the apply commands take real paths only, so the listing hands out exactly those. Applied entries are marked, plus anything applied from outside the store, with the path it came from. `_bashrs_` because the store is this shell\'s: sequencer applies whatever files it is given and has no drawer of its own'; "$HOME/.bashrs/bashrs" autokey_list_bashrs_profiles $argv; end
function autokey_unapply               -d 'Remove profiles from the active set by name (`gaming` or `gaming.toml`); naming none opens an interactive picker listing what is currently applied (sequencer profile-unapply)'; "$HOME/.bashrs/bashrs" autokey_unapply $argv; end
function autokey_detect                -d 'Print the name of each key as it is pressed, once per press — how to learn the key names a binds profile expects. Reads the input devices, so it is exact; `-n` reads the terminal instead, needing no privileges but seeing only keys that type something (sequencer detect-key)'; "$HOME/.bashrs/bashrs" autokey_detect $argv; end
function dl                            -d 'Download a video with the bundled yt-dlp. A YouTube URL (`youtube.com`, `youtu.be`, …) takes the full path — per-video subtitle selection, the playlist unplayable-report, channel tabs sorted into folders; any other site yt-dlp supports takes a generic path — one video downloaded flat into `--into`, the same quality knobs and failure ledger, minus the folder trees (a generic page gives no channel/playlist structure to build them from). `-c` lists what "any other site" tends to cover. The machinery lives in the [`vidl`] crate; this stays the thin argument shell'; "$HOME/.bashrs/bashrs" dl $argv; end
function detect_ai_textual_fingerprint -d 'Find AI marks in a file, or in every file under a directory: hidden characters in text (zero-width joiners, bidi controls, tag chars — with the line and codepoint of each), AI provenance in metadata (frontmatter, `<meta>` generator, XMP CreatorTool, C2PA, vendor names) for md/html/svg/png/jpeg, and writing tells in prose (excess vocabulary, stock phrases, sentence shapes, formatting habits — each with its evidence tier and its reason for doubt). Only the first two are verifiable and only they set the exit code; `--skip-tells` drops the third. Media data is never decoded; changes nothing'; "$HOME/.bashrs/bashrs" detect_ai_textual_fingerprint $argv; end

# stainless comfy repos
function ai            -d 'Launcher for Claude Code agents. Omit the target to open the picker.'; python3 "$HOME/.bashrs/stainless_comfy/contAInerized/dockerized_claude_code/run.py" $argv; end
function ai_audit_self -d 'Audit the launcher\'s persistent state for inconsistencies.'; fish --no-config -c 'builtin cd -- $argv[1]; and exec python3 -m launch.audit $argv[2..]' "$HOME/.bashrs/stainless_comfy/contAInerized/dockerized_claude_code" $argv; end  # a child fish stands in for bash's ( subshell ), so this shell's directory never changes
function q             -d 'Ask one direct question, answered in one shot. Put your prompt in quotes. If you needs to work with files, ask-for/reference them in ~/.ai-agents/quickie/communal/'; python3 "$HOME/.bashrs/stainless_comfy/contAInerized/dockerized_claude_code/quick_question.py" $argv; end
function q2            -d 'Ask one direct question, answered in one shot. Put your prompt in quotes. If you needs to work with files, ask-for/reference them in ~/.ai-agents/quickie/communal/ (--explain)'; python3 "$HOME/.bashrs/stainless_comfy/contAInerized/dockerized_claude_code/quick_question.py" --explain $argv; end
function q3            -d 'Ask one direct question, answered in one shot. Put your prompt in quotes. If you needs to work with files, ask-for/reference them in ~/.ai-agents/quickie/communal/ (--research)'; python3 "$HOME/.bashrs/stainless_comfy/contAInerized/dockerized_claude_code/quick_question.py" --research $argv; end
function ai_stop       -d 'Launcher for Claude Code agents. Omit the target to open the picker. (--stop)'; python3 "$HOME/.bashrs/stainless_comfy/contAInerized/dockerized_claude_code/run.py" --stop $argv; end

# bundled tools
contains -- "$HOME/.bashrs/tools/bin" $PATH; or set -gx PATH "$HOME/.bashrs/tools/bin" $PATH  # bundled tools (python3, ffmpeg, …) win by PATH — as arguments and in shebangs
function python3 -d 'Bundled python3 unless a venv is active (or the bundle is missing), then whatever PATH finds'; if test -z "$VIRTUAL_ENV"; and test -x "$HOME/.bashrs/tools/bin/python3"; "$HOME/.bashrs/tools/bin/python3" $argv; else; command python3 $argv; end; end  # defined last so it beats older same-named rc definitions; a venv (or a missing bundle) falls through to PATH

# environment
set -gx GREP_COLORS 'mt=7;31'  # sets grep marking for found strings to have red background (instead of being bold red)
# HISTTIMEFORMAT has no fish equivalent: fish always records timestamps; view them with `history --show-time='%F_%T  '`
# prepends UTC-time to prompt, colored in red (fish draws its prompt with the fish_prompt function, not PS1)
functions -q __bashrs_orig_fish_prompt; or functions -c fish_prompt __bashrs_orig_fish_prompt  # keep the original once, so re-sourcing doesn't wrap the wrapper
function __bashrs_set_status; return $argv[1]; end
function fish_prompt -d 'UTC time in red, then the original prompt'
    set -l __last_status $status
    set_color --bold red; printf '[%s(UTC)]' (date -u +%T); set_color normal
    __bashrs_set_status $__last_status  # hand the original prompt the real $status
    __bashrs_orig_fish_prompt
end

# keybinds
#   Each binding types the command onto the line and runs it, like bash's `bind '"\en": "shell_new\n"'`.
#   These replace fish defaults on the same keys (Alt+H man page, Alt+W whatis, Alt+L list token).
function __bashrs_bind -a key cmd
    for __mode in default insert  # default covers emacs mode and vi normal mode; insert covers vi insert mode
        bind -M $__mode $key "commandline -r "(string escape -- $cmd)"; commandline -f execute"
    end
end
__bashrs_bind alt-n 'shell_new'       # Alt+N: Start a fresh shell session
__bashrs_bind ctrl-alt-n 'shell_bare' # Ctrl+Alt+N: Fresh shell WITHOUT bashrs (one-shot: any later shell, or re-sourcing, arms it again)
__bashrs_bind alt-h 'brs_sourcefile'  # Alt+H: Print the autogenerated source file, noting where it lives
__bashrs_bind alt-w 'brs_configure'   # Alt+W: Tick the bashrs settings on or off in a form (~/.bashrs/configrs.toml), creating it on first use; `-e` opens the file in your editor instead
__bashrs_bind alt-q 'brs_compile'     # Alt+Q: Recompile and reinstall bashrs by running the project's COMPILE.sh
# ALT+L : restart / reload the running desktop environment (resets visuals, keeps your session)
if pgrep -x cinnamon >/dev/null;                                             __bashrs_bind alt-l 'cinnamon --replace &; disown'
else if pgrep -x gnome-shell >/dev/null; and test "$XDG_SESSION_TYPE" = x11; __bashrs_bind alt-l 'gnome-shell --replace &; disown'
else if pgrep -x kwin_x11 >/dev/null;                                        __bashrs_bind alt-l 'kwin_x11 --replace &; disown'
else if pgrep -x xfwm4 >/dev/null;                                           __bashrs_bind alt-l 'xfwm4 --replace &; disown'
else if pgrep -x marco >/dev/null;                                           __bashrs_bind alt-l 'marco --replace &; disown'
else if pgrep -x budgie-wm >/dev/null;                                       __bashrs_bind alt-l 'budgie-wm --replace &; disown'
else if pgrep -x gala >/dev/null;                                            __bashrs_bind alt-l 'gala --replace &; disown'
else if pgrep -x deepin-wm >/dev/null;                                       __bashrs_bind alt-l 'deepin-wm --replace &; disown'
else if pgrep -x i3 >/dev/null;                                              __bashrs_bind alt-l 'i3-msg restart'
else if pgrep -x qtile >/dev/null;                                           __bashrs_bind alt-l 'qtile cmd-obj -o cmd -f restart'
else if pgrep -x sway >/dev/null;                                            __bashrs_bind alt-l 'swaymsg reload'
else if pgrep -x Hyprland >/dev/null;                                        __bashrs_bind alt-l 'hyprctl reload'
else if pgrep -x labwc >/dev/null;                                           __bashrs_bind alt-l 'labwc --reconfigure'
else if pgrep -x openbox >/dev/null;                                         __bashrs_bind alt-l 'openbox --replace &; disown'
end
functions -e __bashrs_bind

# completion
#   Optional flags displayed through tab-completion. Type `-` and follow up with <TAB>
#   e.g. `gg -<TAB>` lists gg's flags
#   e.g. `gg --de<TAB>` fills in `--delve`
#   Words that don't start with `-` keep fish's normal (file) completion.
function __bashrs_completing_flag; string match -q -- '-*' (commandline -ct); end
for __cmd in brs_compile brs_test brs_configure brs_map_comfy brs_sourcefile diff lll LLL fs_usage git_tree git_rec_pull git_profile dl_page_links _arg_lean_spec media_convert media_convert_quality media_convert_compact media_trim media_metadata media_remove_vocals media_hmerge_imgs media_vmerge_imgs net_excavate net_sonar net_health net_local net_vendor net_bluetooth packages_upup upup packages_update_toolchains UPUP packages_print murder pro_compile pro_test pro_run pro_update_packages pro_readme pro_todo py_install py_update py_rollback shell_args_print shell_def sudo_bashrs g g2 g3 g5 g8 g25 gg gg2 gg3 gg5 gg10 GG GGG hg errcho code_highlight keyword_highlight boecho echobo recho echor gecho echog becho echob cecho echoc yecho echoy orecho echoor wecho echow mecho echom uecho echou urecho echour ugecho echoug ubecho echoub ucecho echouc uyecho echouy uorecho echouor uwecho echouw umecho echoum daecho echoda darecho echodar dagecho echodag dabecho echodab dacecho echodac dayecho echoday daorecho echodaor dawecho echodaw damecho echodam dauecho echodau daurecho echodaur daugecho echodaug daubecho echodaub daucecho echodauc dauyecho echodauy dauorecho echodauor dauwecho echodauw daumecho echodaum table table_fancy backup_diff backup_sync backup_find_bitrot clicker autoclick clicker_benchmark autokey_doctor autokey_check autokey_reformat autokey_apply autokey_list_bashrs_profiles autokey_unapply autokey_detect dl detect_ai_textual_fingerprint
    complete -c $__cmd -n __bashrs_completing_flag -a "(\"\$HOME/.bashrs/bashrs\" complete-flags $__cmd | string split -n ' ')"
end
complete -c ai            -n __bashrs_completing_flag -a '-h --help --dry-run --refresh-installs --stop --find'
complete -c ai_audit_self -n __bashrs_completing_flag -a '-h --help'
complete -c q             -n __bashrs_completing_flag -a '-h --help --explain --research --ai --history --answer --resume'
complete -c q2            -n __bashrs_completing_flag -a '-h --help --research --ai --history --answer --resume'
complete -c q3            -n __bashrs_completing_flag -a '-h --help --explain --ai --history --answer --resume'
complete -c ai_stop       -n __bashrs_completing_flag -a '-h --help --dry-run --refresh-installs --find'
set -e __cmd

# greeting
gecho "Loaded Bashrs! Press "(boecho ALT+H)" to view your functions! Press "(boecho ALT+W)" to edit configurations!"

# stale-config check
if find -H "$HOME/.bashrs" -maxdepth 1 -name 'configrs*.old' -print -quit 2>/dev/null | string length -q
    errcho "bashrs: an archived config (~/.bashrs/configrs*.old) awaits merging into configrs.toml (run 'brs_configure -e' to merge, then delete the .old file)"
end
